wmp.by {
    root * /usr/share/caddy
    encode gzip zstd

    @blocked path /.git* /Caddyfile /Dockerfile /docker-compose.yml /docker-compose.yaml *.py *.scss *.md
    respond @blocked 404

    header Cache-Control "no-cache"
    header /assets/* Cache-Control "public, max-age=31536000, immutable"

    try_files {path} /index.html
    file_server
}
